        "region": "ap-south-1",
        "stat": "Sum",
        "period": 60,
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [ "AWS/Logs", "IncomingBytes", { "label": "Incoming Log Bytes" } ],
          [ "AWS/Logs", "IncomingLogEvents", { "label": "Incoming Log Events", "yAxis": "right" } ]
        ]
      }
    }
