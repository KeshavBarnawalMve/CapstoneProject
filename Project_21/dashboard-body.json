      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 CPU Utilization & Network I/O",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [ "AWS/EC2", "CPUUtilization", { "label": "EC2 Avg CPU (%)" } ],
          [ "AWS/EC2", "NetworkIn", { "label": "Network In (Bytes)", "yAxis": "right" } ],
          [ "AWS/EC2", "NetworkOut", { "label": "Network Out (Bytes)", "yAxis": "right" } ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Request Count & Target Response Time",
        "region": "ap-south-1",
        "stat": "Sum",
        "period": 60,
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [ "AWS/ApplicationELB", "RequestCount", { "label": "Total Requests" } ],
          [ "AWS/ApplicationELB", "TargetResponseTime", { "stat": "Average", "label": "Avg Latency (s)", "yAxis": "right" } ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 24,
      "height": 6,
      "properties": {
